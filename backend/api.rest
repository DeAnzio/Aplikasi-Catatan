@baseUrl = http://localhost:3000
@noteId = 1

# API Testing - Aplikasi Notes
GET {{baseUrl}}/ HTTP/1.1

###

# Health Check
GET {{baseUrl}}/health HTTP/1.1

###

# GET: All Notes
GET {{baseUrl}}/api/notes HTTP/1.1
Content-Type: application/json

###

# GET: Note by ID
GET {{baseUrl}}/api/notes/{{noteId}} HTTP/1.1
Content-Type: application/json

###

# POST: Create Note
POST {{baseUrl}}/api/notes HTTP/1.1
Content-Type: application/json

{
  "judul": "Catatan Baru",
  "isi": "Ini adalah isi dari catatan baru yang dibuat melalui API testing"
}

###

# PUT: Update Note
PUT {{baseUrl}}/api/notes/{{noteId}} HTTP/1.1
Content-Type: application/json

{
  "judul": "Catatan Diperbarui",
  "isi": "Ini adalah isi catatan yang telah diperbarui melalui API testing"
}

###

# DELETE: Delete Note
DELETE {{baseUrl}}/api/notes/{{noteId}} HTTP/1.1
Content-Type: application/json

###

